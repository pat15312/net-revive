# Set to your GitHub user or organization (lowercase).
GHCR_OWNER=your-owner
NETREVIVE_TAG=latest
NETREVIVE_BIND=0.0.0.0
NETREVIVE_PORT=8080
DATABASE_PATH=/data/netrevive.db
# Optional bootstrap password, at least 12 characters. If blank, the setup wizard creates it.
# A nonempty value overrides the stored password on startup; useful for password recovery.
ADMIN_PASSWORD=
# Optional: if set, this key takes precedence over the encrypted key managed in Admin.
UNIFI_API_KEY=
# Optional: at least 32 random characters. If blank, a private key is generated in /data/secret.key.
# Keep this value (or /data/secret.key) with database backups.
SECRET_KEY=
TZ=Europe/London
# Set true when accessing NetRevive over HTTPS. Plain HTTP on a trusted LAN requires false.
COOKIE_SECURE=false
